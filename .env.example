# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (แปลภาษา + แนะนำคำตอบ + embeddings) ---
OPENAI_API_KEY=
# ชื่อโมเดลตั้งในหน้าตั้งค่า > โมเดล AI เป็นหลัก ค่าด้านล่างเป็นค่าสำรองตอนหน้าตั้งค่ายังไม่มีค่าเท่านั้น
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- LINE OA (@p49clinic) : LINE Developers > Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- ใช้ป้องกัน endpoint cron (fallback AI) ---
CRON_SECRET=change-me

# --- ใช้ hash IP ใน rate limit ของ web chat (สุ่มยาวๆ) ---
IP_HASH_SECRET=

# --- ใช้เซ็น URL รูปขาออกที่ LINE/Meta ดึง (สุ่มยาวๆ) เปลี่ยนแล้วลิงก์รูปเดิมใช้ไม่ได้ ---
MEDIA_URL_SECRET=

# --- อีเมลแจ้งเตือนเมื่อระบบผิดปกติ (ไม่ตั้งก็ได้ แถบแดงในหน้าเว็บยังทำงาน) ---
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_EMAIL_FROM=

# เชื่อมระบบ HR (ไม่บังคับ) ถ้าไม่ตั้งทั้งสองค่า หน้า /staff จะซ่อนการซิงก์
HR_SYNC_URL=
HR_SYNC_SECRET=

# ส่งคะแนนตอบแชทของเจ้าหน้าที่เข้า HR ทุกวัน 01:00 น. (Vercel Cron → /api/cron/hr-kpi)
# ตั้งสองค่านี้แล้ว หน้า /staff ใช้ endpoint เดียวกันดึงรายชื่อพนักงาน HR ได้ด้วย (?action=employees)
HR_KPI_URL=
HR_KPI_KEY=

# แจ้งเตือนนัดบนมือถือ (Web Push) สร้างด้วย npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ราคาบริการจากเว็บ happiwellclinic.com (publishable key อ่านได้อย่างเดียว)
WEBSITE_SUPABASE_URL=
WEBSITE_SUPABASE_KEY=

# URL ของแอปนี้ (ใช้ใน widget)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Facebook Messenger + Instagram (Meta App Dashboard) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
