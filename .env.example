# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (แปลภาษา + แนะนำคำตอบ + embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- LINE OA (@p49clinic) : LINE Developers > Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- ใช้ป้องกัน endpoint cron (fallback AI) ---
CRON_SECRET=change-me

# --- ใช้ hash IP ใน rate limit ของ web chat (สุ่มยาวๆ) ---
IP_HASH_SECRET=

# URL ของแอปนี้ (ใช้ใน widget)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Facebook Messenger + Instagram (Meta App Dashboard) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
